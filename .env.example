# Environment Configuration
ENV=development
DEBUG=true

# LLM Configuration
# Options: "mock" (default offline deterministic mode, 0 API cost), "openai", "groq", "anthropic"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ActionGate Authorization Engine
ACTIONGATE_BASE_URL=http://localhost:8001
ACTIONGATE_API_KEY=ag-secret-key-production
ACTIONGATE_TIMEOUT_SECONDS=5.0

# Mini ERP Business Backend
ERP_BASE_URL=http://localhost:8000
ERP_API_KEY=erp-secret-key-production
ERP_JWT_SECRET=erp-jwt-secret-shared
ERP_TIMEOUT_SECONDS=5.0

# Mode flags
# When USE_MOCKS is true, the system uses high-fidelity in-memory simulated contracts
USE_MOCKS=true
