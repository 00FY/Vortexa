# ─────────────────────────────────────────────────────────────────────────────
# ActionGate AI Agent Orchestrator — Environment Configuration
# Copy this file to .env and fill in the values appropriate for your environment.
# NEVER commit a .env file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service environment ────────────────────────────────────────────────────────
ENV=development
DEBUG=true

# ── LLM configuration ─────────────────────────────────────────────────────────
# LLM_PROVIDER controls the intent-classification and field-extraction backend.
#
#   mock    (default) — deterministic regex/keyword logic. Zero API cost.
#                       Required for all unit and integration tests.
#         sure              All 25 tests pass with this setting and no network access.
#
#   openai             — Real OpenAI API calls via langchain_openai.ChatOpenAI.
#                       Requires OPENAI_API_KEY below.
#                       If the API is unavailable, the system fails closed —
#                       no protected ERP write will proceed.

LLM_PROVIDER=mock

# Model used when LLM_PROVIDER=openai.
# Supported models that handle structured outputs (function calling):
#   gpt-4o-mini  (recommended — low cost, fast, supports with_structured_output)
#   gpt-4o
#   gpt-4-turbo
LLM_MODEL=gpt-4o-mini

# OpenAI API key — required only when LLM_PROVIDER=openai.
# Read securely from environment; never hardcoded or logged.
OPENAI_API_KEY=

# ── ActionGate Authorization Engine ───────────────────────────────────────────
ACTIONGATE_BASE_URL=http://localhost:8001
ACTIONGATE_API_KEY=ag-secret-key-production
ACTIONGATE_TIMEOUT_SECONDS=5.0

# ── Mini ERP Business Backend ─────────────────────────────────────────────────
ERP_BASE_URL=http://localhost:8000
ERP_API_KEY=erp-secret-key-production
ERP_JWT_SECRET=erp-jwt-secret-shared
ERP_TIMEOUT_SECONDS=5.0

# ── Mock mode ─────────────────────────────────────────────────────────────────
# When USE_MOCKS=true, the system uses high-fidelity in-memory simulated
# contracts instead of making real HTTP calls to ActionGate and the ERP backend.
# Set to false only when all services are running locally.
USE_MOCKS=true
